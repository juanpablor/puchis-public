import React, { useContext, useState } from "react";
import { CartContext } from "../context/cartContext";
import { graphql, Link } from "gatsby";
import Layout from "../components/layout";
import { UserProfile } from "../interfaces";
import data from "../data/data.json";
import { useTranslation } from "gatsby-plugin-react-i18next";
import { FiArrowLeft } from "react-icons/fi";
import { db } from "../../firebaseConfig";
import { collection, addDoc } from "firebase/firestore";
import emailjs from "emailjs-com";
import SEO from "../components/seo";

const CheckoutPage = () => {
  const { t } = useTranslation();
  const cartContext = useContext(CartContext);
  const [customerEmail, setCustomerEmail] = useState("");
  const [customerName, setCustomerName] = useState("");
  const [customerPhone, setCustomerPhone] = useState("");
  const [orderConfirmed, setOrderConfirmed] = useState(false);

  if (!cartContext) {
    return <div>{t("cart.cartContextError")}</div>;
  }

  const userData: UserProfile = data;
  const { cart, clearCart } = cartContext;
  const total = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);

  const formattedOrderDetails = cart
    .map(
      (item) =>
        `${item.name} | ${t("cart.quantity")}: ${item.quantity} | ${t(
          "cart.price"
        )}: ${(item.price * item.quantity).toFixed(2)} $`
    )
    .join("\n");

  async function confirmDelivery(total: number, orderDetails: string, totalAmount: string) {
    try {
      const order = {
        customerName,
        customerEmail,
        customerPhone,
        items: cart,
        total: total,
        date: new Date().toISOString(),
      };

      const orderRef = await addDoc(collection(db, "orders"), order);
      console.log("Pedido guardado con ID:", orderRef.id);
    } catch (error) {
      console.error("Error guardando el pedido:", error);
    }

    try {
      const templateParams = {
        to_name: "Puchis Alison Pulido",
        from_name: customerName,
        reply_to: customerEmail,
        phone: customerPhone,
        order_details: orderDetails,
        total_amount: totalAmount,
        delivery_date: "Sin fecha asignada",
      };

      const response = await emailjs.send(
        "service_sm8nf4i",
        "template_70yne3j",
        templateParams,
        "u2Op-9wm_t5yR4it5"
      );

      console.log("Correo enviado con éxito:", response.status, response.text);
    } catch (error) {
      console.error("Error enviando correo:", error);
    }

    setOrderConfirmed(true);
  }

  return (
    <> 
    <SEO seo={t("seoCheckout", { returnObjects: true })} />
      <Layout data={userData}>
        <div className="container mx-auto p-4 relative mt-4 readable">
          {orderConfirmed ? (
            <div className="text-center bg-primary text-secondary p-6 rounded-lg shadow-md">
              <h2 className="text-3xl font-bold mb-4">{t("cart.thank_you")}</h2>
              <h3 className="text-2xl font-bold mb-4">{t("instructions.title")}</h3>
              <ul className="text-lg text-white text-left max-w-3xl mx-auto">
                {(t("instructions.content", { returnObjects: true }) as any[]).map((item, index) => (
                  <li key={index} className="my-4">
                    {index + 1}. {item.title}{" "}
                    <span className="mb-4" dangerouslySetInnerHTML={{ __html: item.copy }}></span>
                  </li>
                ))}
              </ul>
              <Link to="/" className="bg-secondary text-light px-6 py-3 rounded mt-6 inline-block" onClick={clearCart}>
                {t("cart.return_home")}
              </Link>
            </div>
          ) : (
            <>
              <div className="flex justify-between items-center mb-4">
                <h1 className="text-secondary text-3xl">{t("cart.checkout")}</h1>
                <Link to="/cart" className="bg-secondary text-light px-4 py-2 rounded flex items-center text-2xl">
                  <FiArrowLeft className="text-2xl mr-4" /> {t("cart.backToCart")}
                </Link>
              </div>

              <div className="bg-secondary text-white p-6 rounded-lg shadow-md">
                <h2 className="text-2xl font-bold mb-4">{t("cart.purchaseSummary")}</h2>
                <div className="space-y-2">
                  {cart.map((item) => (
                    <div key={item.id} className="flex justify-between">
                      <span>{item.name} (x{item.quantity})</span>
                      <span>${(item.price * item.quantity).toFixed(2)}</span>
                    </div>
                  ))}
                </div>
                <div className="text-xl border-t mt-4 pt-4">
                  <div className="flex justify-between font-bold text-3xl">
                    <span>{t("cart.total")}</span>
                    <span>${total.toFixed(2)}</span>
                  </div>
                </div>
              </div>

              <div className="bg-secondary text-white mt-8 p-6 rounded-lg shadow-md">
                <h2 className="text-2xl font-bold mb-4">{t("cart.paymentInfo")}</h2>
                <div className="flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-4 items-center">
                  <label className={styles.label}>{t("cart.name")}</label>
                  <input className={styles.input} type="text" value={customerName} onChange={(e) => setCustomerName(e.target.value)} required />

                  <label className={styles.label}>{t("cart.email")}</label>
                  <input className={styles.input} type="email" value={customerEmail} onChange={(e) => setCustomerEmail(e.target.value)} required />

                  <label className={styles.label}>{t("cart.phone")}</label>
                  <input className={styles.input} type="phone" value={customerPhone} onChange={(e) => setCustomerPhone(e.target.value)} required />
                </div>

                <div className="mx-auto mt-8 w-1/2">
                  {customerName && customerEmail ? (
                    <button
                      onClick={() => confirmDelivery(total, formattedOrderDetails, total.toFixed(2))}
                      className="bg-primary text-light px-4 py-2 rounded mt-4 mx-auto block"
                    >
                      {t("cart.submit_order")}
                    </button>
                  ) : (
                    <p className="text-primary text-center">
                      {t("cart.enter_name_email")}
                    </p>
                  )}
                </div>
              </div>
            </>
          )}
        </div>
      </Layout>    
    </>

  );
};

export default CheckoutPage;

export const query = graphql`
  query ($language: String!) {
    locales: allLocale(filter: { language: { eq: $language } }) {
      edges {
        node {
          ns
          data
          language
        }
      }
    }
  }
`;

const styles = {
  input: "bg-semilight placeholder:text-light text-light text-xl w-full p-2 border rounded",
  label: "block text-lg font-medium mb-1",
};
