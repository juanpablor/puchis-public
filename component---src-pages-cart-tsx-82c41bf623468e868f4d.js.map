import React, { useContext } from "react";
import { CartContext } from "../context/cartContext";
import { graphql, Link } from "gatsby";
import Layout from "../components/layout";
import { UserProfile } from "../interfaces";
import data from "../data/data.json";
import { useTranslation } from "gatsby-plugin-react-i18next";
import { FiArrowLeft } from "react-icons/fi";
import images from "../images";
import SEO from "../components/seo";

const CartPage = () => {
  const { t } = useTranslation();
  const cartContext = useContext(CartContext);
  if (!cartContext) {
    return <div>{t("cart.cartContextError")}</div>;
  }
  const userData: UserProfile = data;

  const {
    cart,
    removeFromCart,
    clearCart,
    decreaseQuantity,
    increaseQuantity,
  } = cartContext;

  // Calculate the total number of items in the cart
  const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);

  // Calculate the total price of the cart
  const totalPrice = cart.reduce(
    (sum, item) => sum + item.price * item.quantity,
    0
  );

  return (
    <> 
      <SEO seo={t("seoCart", { returnObjects: true })} />
      <Layout data={userData}>
        <div className="container mx-auto p-4 relative mt-4 readable">
          {/* Header to go back to the products page */}
          <div className="flex flex-col sm:flex-row justify-between items-center mb-4">
            <h1 className="text-secondary text-3xl w-full text-center sm:w-auto">
              {t("cart.ShoppingCart")}
            </h1>
            <Link
              to="/"
              className="bg-secondary text-light px-4 py-2 rounded flex items-center justify-center text-2xl w-full sm:w-auto"
            >
              <FiArrowLeft className="text-2xl mr-4" /> {t("cart.backToProducts")}
            </Link>
          </div>

          {/* Show the cart items */}
          {cart.length === 0 ? (
            <p className="text-secondary text-center text-4xl">{t("cart.cartIsEmpty")}</p>
          ) : (
            <div className="space-y-4">
              {cart.map((item) => (
                <div
                  key={item.id}
                  className="border-secondary border p-4 rounded-lg flex flex-col sm:flex-row justify-between items-center"
                >
                  <div className="w-24 h-24 overflow-hidden rounded-lg ">
                    <img src={images[item.image].src} alt="" />
                  </div>
                  <div className="text-center">
                    <h2 className="text-pink text-5xl charm-bold text-shadow font-semibold">
                      {item.name}
                    </h2>
                    <p className="text-pink text-3xl">
                      ${item.price} x {item.quantity}
                    </p>
                  </div>
                  <div className="flex items-center gap-4">
                    <span className="text-pink font-bold text-3xl">
                      {t("cart.total")}: ${item.price * item.quantity}
                    </span>

                    <div className="flex items-center gap-2">
                      <button
                        className="bg-pink text-light px-3 text-4xl rounded disabled:opacity-50"
                        onClick={() => decreaseQuantity(item.id)}
                        disabled={item.quantity <= 0} // Disable if quantity is 0
                      >
                        -
                      </button>
                      <span className="text-semilight text-shadow font-bold text-4xl">
                        {item.quantity}
                      </span>
                      <button
                        className="bg-secondary text-light px-3 text-4xl rounded disabled:opacity-50"
                        onClick={() => increaseQuantity(item.id)}
                        disabled={item.quantity >= 20} // Disable if quantity is 20
                      >
                        +
                      </button>
                    </div>

                    <button
                      className="bg-pink text-light px-4 py-2 rounded"
                      onClick={() => removeFromCart(item.id)}
                    >
                      {t("cart.remove")}
                    </button>
                  </div>
                </div>
              ))}
            </div>
          )}

          {/* Total items */}
          <div className="text-pink mt-4 text-right font-bold text-2xl">
            {t("cart.totalItems")}:{" "}
            <span className="text-semilight text-3xl text-shadow">
              {totalItems}
            </span>
          </div>

          {/* Total price */}
          <div className="text-pink mt-2 text-right font-bold text-2xl">
            {t("cart.totalPrice")}:{" "}
            <span className="text-secondary text-3xl text-shadow">
              ${totalPrice.toFixed(2)}
            </span>
          </div>

          {/* Button to clear the cart */}
          {cart.length > 0 && (
            <div className="mt-4 text-right">
              <button
                className="bg-secondary text-light text-2xl px-6 py-2 rounded"
                onClick={clearCart}
              >
                {t("cart.emptyCart")}
              </button>
            </div>
          )}
        </div>

        {cart.length > 0 && (<Link
          to="/checkout"
          className="bg-secondary text-light text-2xl px-4 py-2 rounded w-full sm:w-1/3 mx-auto relative flex justify-center my-4"
        >
          {t("cart.checkout")}
        </Link>)}
      </Layout>    
    </>

  );
};

export default CartPage;

export const query = graphql`
  query ($language: String!) {
    locales: allLocale(filter: { language: { eq: $language } }) {
      edges {
        node {
          ns
          data
          language
        }
      }
    }
  }
`;
