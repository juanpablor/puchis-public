import React, { useState, useEffect } from "react";
import { Trans, useTranslation } from "gatsby-plugin-react-i18next";
import { FiMenu, FiX } from "react-icons/fi";
import { FaArrowUp } from "react-icons/fa";
import { isHome } from '../constants/constants';

interface NavProps {
  data?: {
    menu: string[];
  };
}

const Navigation: React.FC<NavProps> = ({ data }) => {
  const { t } = useTranslation();
  const [isMenuOpen, setIsMenuOpen] = useState(false);
  const [showBackToTop, setShowBackToTop] = useState(false);

  if (!data || !data.menu) {
    return null;
  }

  const toggleMenu = () => {
    setIsMenuOpen(!isMenuOpen);
  };

  const scrollToTop = () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  };

  useEffect(() => {
    const handleScroll = () => {
      if (window.scrollY > 100) {
        setShowBackToTop(true);
      } else {
        setShowBackToTop(false);
      }
    };
    window.addEventListener("scroll", handleScroll);
    return () => {
      window.removeEventListener("scroll", handleScroll);
    };
  }, []);

  return (
    <nav className={styles.container}>
      {isHome() && <button onClick={toggleMenu} className={styles.burgerButton}>
        {isMenuOpen ? (
          <FiX className="text-secondary fixed right-4 z-[70] top-4" size={36} />
        ) : (
          <FiMenu className="text-secondary mx-8" size={36} />
        )}
      </button>}

      {isHome() && <ul
        className={`${styles.buttonsWrapper} ${
          isMenuOpen ? styles.menuOpen : styles.menuClosed
        }`}
      >
        {data.menu.map((item: string, index: number) => (
          <li key={index} className={styles.buttonsContainer}>
            <button
              onClick={() => {
                if(item == 'products') {
                  setTimeout(() => {
                    document.getElementById('products1')?.scrollIntoView({ behavior: "smooth" })
                  }, 1);
                }  
                document
                  .getElementById(item)
                  ?.scrollIntoView({ behavior: "smooth" });
                setIsMenuOpen(!isMenuOpen);
              }}
              className={styles.buttons}
            >
              <Trans i18nKey={`menu.${item}`}>{t(`menu.${item}`)}</Trans>
            </button>
          </li>
        ))}
      </ul>}

      {showBackToTop && (
        <button onClick={scrollToTop} className={styles.backToTopButton}>
          <FaArrowUp size={20} />
        </button>
      )}
    </nav>
  );
};

export default Navigation;

const styles = {
  container:
    "inline-block justify-between items-center transparent px-4 py-2 mx-0 sm:mx-8 relative z-10",
  burgerButton: "md:hidden block focus:outline-none mx-auto ",
  buttonsWrapper:
    "flex flex-col md:flex-row justify-evenly items-center w-full fixed sm:relative left-0 top-0 py-8 sm:py-0 gap-4 bg-primary sm:bg-transparent",
  buttonsContainer: "my-4 sm:my-0 bg-secondary rounded-xl hover:bg-terciary",
  buttons: "text-light px-8 py-4 text-xl hover:text-light",
  menuOpen: "block md:flex",
  menuClosed: "hidden md:flex",
  backToTopButton:
    "fixed bottom-4 right-4 bg-terciary text-white p-2 rounded-full shadow-lg z-50",
  logoContainer:
    "flex justify-center items-center shadow-2xl rounded-2xl w-full bg-[red]",
  logo: "w-full rounded-2xl bg-[green]",
};
