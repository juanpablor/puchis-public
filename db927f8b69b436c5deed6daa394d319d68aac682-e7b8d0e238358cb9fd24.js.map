import React, { ReactNode, useState } from "react";
import { UserProfile } from "../interfaces";
import Navigation from "../components/nav";
import LanguageSelector from "../components/languageSelector";
import { useTranslation } from "gatsby-plugin-react-i18next";
import { SiInstagram } from "react-icons/si";
import { ImFacebook2 } from "react-icons/im";
import {
  FaSquareFacebook,
  FaSquarePhone,
  FaSquareWhatsapp,
} from "react-icons/fa6";
import { MdEmail } from "react-icons/md";
import images from "../images";
import data from "../data/data.json";

interface LayoutProps {
  children: ReactNode;
  data?: UserProfile;
}

interface FooterData {
  copy: string;
}

const userData: UserProfile = data;

const Layout: React.FC<LayoutProps> = ({ children, data }) => {
  const { t } = useTranslation();
  const footerContent: { followUs: string; content: FooterData[] } = t(
    "footer",
    { returnObjects: true }
  ) || { followUs: "", content: [] };
  const currentYear = new Date().getFullYear();

  function formatPhoneNumber(phoneNumber: string) {
    const cleanedPhoneNumber = phoneNumber.replace(/\D+/g, "");
    if (cleanedPhoneNumber.startsWith("1")) {
      return `+1 ${cleanedPhoneNumber.slice(1, 4)} ${cleanedPhoneNumber.slice(
        4,
        7
      )} ${cleanedPhoneNumber.slice(7, 12)}`;
    } else {
      return cleanedPhoneNumber;
    }
  }

  return (
    <>

      <div id={data?.menu[0]} className={styles.container}>
        <div className={styles.header}>
                {/* Logo en el centro */}
      <a className={styles.logoContainer}>
        <img src={images.logo.src} alt={images.logo.alt} className={styles.logo} />
      </a>
          <Navigation data={data} />
          <LanguageSelector data={data} />
        </div>
        <div>{children}</div>
      </div>

      <footer className={styles.footerContainer}  id={userData.menu[4]}>
        <div className="flex flex-col sm:flex-row">

          <div className="flex flex-col rounded-2xl self-center w-full py-8">
            <img className="w-1/3 mx-auto shadow-2xl rounded-2xl" src={images.logo.src} alt={images.logo.src} />
          </div>

          <div className="flex flex-col w-full self-center">

          <a
              href={`mailto:${data?.email}`}
              className="flex readable flex-row gap-2 justify-center items-center text-2xl sm:text-5xl font-bold"
            >
              <MdEmail />
              {data?.email} 
              </a>           
            <div className="mx-auto readable text-2xl sm:text-4xl p-4 text-center">
              &copy; {currentYear} {data?.name}
            </div>
          </div>
          
        </div>
      </footer>
    </>
  );
};

export default Layout;

const styles = {
  container: "mx-auto",
  header: "mt-6 flex flex-row justify-center items-center py-4 sm:py-0",
  footerContainer: "flex flex-col bg-secondary text-light relative",
  logoContainer: "flex justify-center items-center shadow-2xl rounded-2xl relative",
  logo: "w-40 sm:w-[22rem] h-auto rounded-2xl",
};
